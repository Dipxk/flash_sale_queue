# Ignore bundler config.
/.bundle

# Ignore all environment files (except examples).
/.env*
!/.env*.example

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage.
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# Ignore master key for decrypting credentials and more.
/config/master.key

# Ignore uploaded files.
/public/uploads

# Ignore node modules if added later.
/node_modules

# Ignore key files and certificates.
/config/*.key
/config/*.pem

# Ignore coverage and test artifacts.
/coverage
/spec/examples.txt

# Ignore load-test result dumps (keep scripts).
/load_tests/results/*
!/load_tests/results/.gitkeep

# macOS
.DS_Store

# IDE
.idea/
.vscode/
*.swp

# Kamal / local
.kamal/secrets
